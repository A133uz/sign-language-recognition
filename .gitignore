# Local Python environments and tools
.venv/
.cache/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
build/
dist/

# Local settings and credentials
.env
.env.*
!.env.example
.idea/
.vscode/
*.log
*.pem
*.key
Thumbs.db
.DS_Store

# Research inputs and generated artifacts; keep documentation only
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/checkpoints/*
!/checkpoints/README.md
/assets/models/*
!/assets/models/README.md
/runs/*
!/runs/.gitkeep

# Prevent accidental media/weight commits outside their designated folders
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.onnx
*.task
*.safetensors
